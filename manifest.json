{
  "manifest_version": 3,
  "name": "FatPass",
  "version": "1.1.0",
  "description": "See how much you really spend on DoorDash and Uber Eats: totals, fees, tips, restaurants, items and trends.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.doordash.com/*",
    "https://www.ubereats.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doordash.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ubereats.com/*"
      ],
      "js": [
        "ubereats.js"
      ],
      "run_at": "document_idle"
    }
  ]
}